# Bulwark Analyzer Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# CLI Configuration
# ===========================================

# CLI API Key - Must match the CLI_API_KEY in the backend
# Generate with: openssl rand -base64 32
CLI_API_KEY=your_cli_api_key_here

# ===========================================
# AI Analysis (OpenAI)
# ===========================================

# OpenAI API Key for AI-powered code analysis
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# Server Configuration
# ===========================================

# Port for the analyzer HTTP server (default: 8080)
PORT=8080

# Shared workspace path for file exchange with NestJS backend
SHARED_WORKSPACE_PATH=/tmp/shared/workspaces

# ===========================================
# Solana RPC (Optional - for on-chain analysis)
# ===========================================

# Solana RPC URL for upgradeability/governance analysis
# SOLANA_RPC_URL=https://api.devnet.solana.com

