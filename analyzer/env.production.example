# Bulwark Analyzer - Production Environment
# Copy this file to the server at: /home/azureuser/apps/production/.env.analyzer.production

# ===========================================
# Server Configuration
# ===========================================

# Port for the analyzer HTTP server
PORT=8080

# Shared workspace path for file exchange with NestJS backend
SHARED_WORKSPACE_PATH=/tmp/shared/workspaces

# ===========================================
# AI Analysis (OpenAI)
# ===========================================

# OpenAI API Key for AI-powered code analysis
# Required for AI factor analysis
OPENAI_API_KEY=sk-your-production-openai-api-key

# ===========================================
# Solana RPC (Optional)
# ===========================================

# Solana RPC URL for upgradeability/governance analysis
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

