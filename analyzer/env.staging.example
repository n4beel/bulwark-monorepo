# Bulwark Analyzer - Staging Environment
# Copy this file to the server at: /home/azureuser/apps/staging/.env.analyzer.staging

# ===========================================
# Server Configuration
# ===========================================

# Port for the analyzer HTTP server (staging uses 8081)
PORT=8081

# Shared workspace path for file exchange with NestJS backend
SHARED_WORKSPACE_PATH=/tmp/shared/workspaces

# ===========================================
# AI Analysis (OpenAI)
# ===========================================

# OpenAI API Key for AI-powered code analysis
# Can use same key as production or a separate one for testing
OPENAI_API_KEY=sk-your-staging-openai-api-key

# ===========================================
# Solana RPC (Optional)
# ===========================================

# Solana RPC URL for upgradeability/governance analysis
# SOLANA_RPC_URL=https://api.devnet.solana.com

